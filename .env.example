# Copy to .env.local and fill in. .env.local is never committed.
#
# PacketBrawl shares the Soultale Supabase project and keeps its tables in a
# schema of its own. See docs/architecture.md for why.
#
# Both values are on the Supabase dashboard under Project Settings, API.
# Neither is a secret: the URL and the publishable key both ship inside the
# browser bundle of any Supabase app, and row level security is what actually
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The service role key bypasses row level security completely.
#
# It belongs only to the server routes that write game state, it is set in the
# Vercel dashboard rather than in any file, and it must never carry the
# NEXT_PUBLIC_ prefix. That prefix is what puts a value in the browser bundle,
# and this is the one value that ending up there would hand every player the
# ability to write anybody's match.
#
# SUPABASE_SERVICE_ROLE_KEY=
