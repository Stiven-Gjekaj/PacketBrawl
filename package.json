{
  "name": "packetbrawl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim --noEmit && tsc -p packages/content --noEmit && tsc -p apps/web --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter @packetbrawl/web dev",
    "build": "pnpm --filter @packetbrawl/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
